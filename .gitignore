# Project history: earlier versions of the source and the .bat menus that preceded
# the graphical interface. Kept on disk, outside the repo.
.archive/

# Compiled binary. Generated from Speculum.cs with the command in the README and
# published attached to each release, not versioned: otherwise every rebuild
# duplicates 30 KB in the history and it easily drifts from the source.
Speculum.exe

# Recordings the app creates next to the executable. 'Grabaciones' is the name the
# folder had while the interface was in Spanish; the app renames it on startup, but
# an old copy may still be around.
Recordings/
Grabaciones/

# Previews from the icon generator: working material, regenerated with
# tools/make-icon.ps1. The .ico and docs/icon.png are versioned.
tools/preview-*.png
