# Historico del proyecto: versiones previas del fuente y los menus .bat que
# precedieron a la interfaz grafica. Se conservan en disco, fuera del repo.
.archive/

# Binario compilado. Se genera desde Speculum.cs con el comando del README
# y se publica adjunto a cada release, no versionado: si no, cada recompilacion
# duplica 30 KB en el historial y es facil que quede desfasado del fuente.
Speculum.exe

# Grabaciones que crea la app junto al ejecutable
Grabaciones/

# Vistas previas del generador de iconos: material de trabajo, se regeneran con
# tools/make-icon.ps1. El .ico y docs/icon.png si van versionados.
tools/preview-*.png
